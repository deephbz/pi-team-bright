{
  "version": 1,
  "id": "synthetic-clock-gap",
  "source": "synthetic",
  "assumptions": ["S-first-worker-pane-is-pane-1"],
  "setup": { "ptbVersion": "v3.1", "teams": [] },
  "steps": [
    { "at": 0, "step": { "kind": "pi.start", "who": { "team": "team-1", "actor": "lead" }, "session": "session-1", "reason": "startup" } },
    { "at": 0, "step": { "kind": "tool.call", "who": { "team": "team-1", "actor": "lead" }, "tool": "team_create", "args": { "name": "team-1", "purpose": "Synthetic lifecycle verification" } } },
    { "at": 0, "step": { "kind": "tool.call", "who": { "team": "team-1", "actor": "lead" }, "tool": "ensure_worker", "args": { "name": "w1", "scope": "text-1" } } },
    { "at": 86400000, "step": { "kind": "herdr.agentState", "pane": "pane-1", "state": "unknown" } },
    { "at": 86400000, "step": { "kind": "tool.call", "who": { "team": "team-1", "actor": "lead" }, "tool": "team_sync", "args": { "view": "updates" } } },
    { "at": 86400000, "step": { "kind": "tool.call", "who": { "team": "team-1", "actor": "w1" }, "tool": "task_read", "args": { "task_id": "task-1" } } },
    { "at": 86400000, "step": { "kind": "turn.end", "who": { "team": "team-1", "actor": "w1" }, "outcome": "settled" } }
  ]
}
