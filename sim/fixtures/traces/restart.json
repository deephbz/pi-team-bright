{
  "version": 1,
  "id": "synthetic-restart",
  "source": "synthetic",
  "assumptions": [],
  "setup": { "ptbVersion": "v3.1", "teams": [] },
  "steps": [
    { "at": 0, "step": { "kind": "pi.start", "who": { "team": "team-1", "actor": "lead" }, "session": "session-1", "reason": "startup" } },
    { "at": 0, "step": { "kind": "tool.call", "who": { "team": "team-1", "actor": "lead" }, "tool": "team_create", "args": { "name": "team-1" } } },
    { "at": 0, "step": { "kind": "tool.call", "who": { "team": "team-1", "actor": "lead" }, "tool": "ensure_worker", "args": { "name": "w1", "scope": "text-1" } } },
    { "at": 0, "step": { "kind": "turn.end", "who": { "team": "team-1", "actor": "w1" }, "outcome": "settled" } },
    { "at": 0, "step": { "kind": "pi.shutdown", "who": { "team": "team-1", "actor": "w1" }, "reason": "reload" } },
    { "at": 2000, "step": { "kind": "tool.call", "who": { "team": "team-1", "actor": "lead" }, "tool": "ensure_worker", "args": { "name": "w1", "scope": "text-1" } } },
    { "at": 2000, "step": { "kind": "tool.call", "who": { "team": "team-1", "actor": "w1" }, "tool": "task_read", "args": { "task_id": "task-1" } } },
    { "at": 2000, "step": { "kind": "agent.settled", "who": { "team": "team-1", "actor": "w1" } } }
  ]
}
