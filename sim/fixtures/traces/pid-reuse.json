{
  "version": 1,
  "id": "synthetic-pid-reuse",
  "source": "synthetic",
  "assumptions": [],
  "setup": { "ptbVersion": "v3.1", "teams": [] },
  "steps": [
    { "at": 0, "step": { "kind": "pi.start", "who": { "team": "team-1", "actor": "lead" }, "session": "session-1", "reason": "startup" } },
    { "at": 0, "step": { "kind": "tool.call", "who": { "team": "team-1", "actor": "lead" }, "tool": "team_create", "args": { "name": "team-1", "purpose": "Synthetic lifecycle verification" } } },
    { "at": 0, "step": { "kind": "tool.call", "who": { "team": "team-1", "actor": "lead" }, "tool": "ensure_worker", "args": { "name": "w1", "scope": "text-1" } } },
    { "at": 10000, "step": { "kind": "agent.settled", "who": { "team": "team-1", "actor": "w1" } } },
    { "at": 10000, "step": { "kind": "os.kill", "who": { "team": "team-1", "actor": "w1" }, "signal": "SIGKILL" } },
    { "at": 10000, "step": { "kind": "os.pidReuse", "dead": { "team": "team-1", "actor": "w1" }, "newcomer": "process-2" } },
    { "at": 120000, "step": { "kind": "tool.call", "who": { "team": "team-1", "actor": "lead" }, "tool": "team_sync", "args": { "view": "updates" } } },
    { "at": 120000, "step": { "kind": "tool.call", "who": { "team": "team-1", "actor": "lead" }, "tool": "ensure_worker", "args": { "name": "w1", "scope": "text-1" } } }
  ]
}
