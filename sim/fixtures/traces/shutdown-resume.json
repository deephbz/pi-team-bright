{
  "version": 1,
  "id": "synthetic-shutdown-resume",
  "source": "synthetic",
  "assumptions": [],
  "setup": { "ptbVersion": "v3.1", "teams": [] },
  "steps": [
    { "at": 0, "step": { "kind": "pi.start", "who": { "team": "team-1", "actor": "lead" }, "session": "session-1", "reason": "startup" } },
    { "at": 0, "step": { "kind": "tool.call", "who": { "team": "team-1", "actor": "lead" }, "tool": "team_create", "args": { "name": "team-1", "purpose": "Synthetic lifecycle verification" } } },
    { "at": 0, "step": { "kind": "human.interrupt", "who": { "team": "team-1", "actor": "lead" } } },
    { "at": 0, "step": { "kind": "turn.end", "who": { "team": "team-1", "actor": "lead" }, "outcome": "aborted" } },
    { "at": 0, "step": { "kind": "pi.shutdown", "who": { "team": "team-1", "actor": "lead" }, "reason": "quit" } },
    { "at": 0, "step": { "kind": "os.reboot" } },
    { "at": 60000, "step": { "kind": "pi.start", "who": { "team": "team-1", "actor": "lead" }, "session": "session-1", "reason": "resume" } },
    { "at": 60000, "step": { "kind": "tool.call", "who": { "team": "team-1", "actor": "lead" }, "tool": "team_sync", "args": { "view": "snapshot" } } },
    { "at": 60000, "step": { "kind": "turn.end", "who": { "team": "team-1", "actor": "lead" }, "outcome": "settled" } },
    { "at": 60000, "step": { "kind": "agent.settled", "who": { "team": "team-1", "actor": "lead" } } }
  ]
}
