{
  "version": 1,
  "id": "synthetic-bound-pi-dead",
  "source": "synthetic",
  "assumptions": ["S-first-worker-pane-is-pane-1", "A2"],
  "setup": { "ptbVersion": "baseline", "teams": [] },
  "steps": [
    { "at": 0, "step": { "kind": "pi.start", "who": { "team": "team-1", "actor": "lead" }, "session": "session-1", "reason": "startup" } },
    { "at": 0, "step": { "kind": "tool.call", "who": { "team": "team-1", "actor": "lead" }, "tool": "team_create", "args": { "name": "team-1", "purpose": "Synthetic lifecycle verification" } } },
    { "at": 0, "step": { "kind": "tool.call", "who": { "team": "team-1", "actor": "lead" }, "tool": "ensure_worker", "args": { "name": "w1", "scope": "text-1" } } },
    { "at": 1, "step": { "kind": "pi.start", "who": { "team": "team-1", "actor": "w1" }, "session": "session-2", "reason": "startup" } },
    { "at": 2, "step": { "kind": "os.kill", "who": { "team": "team-1", "actor": "w1" }, "signal": "SIGKILL" } },
    { "at": 2, "step": { "kind": "herdr.agentState", "pane": "pane-1", "state": "unknown" } },
    { "at": 3, "step": { "kind": "human.typeInPane", "pane": "pane-1", "text": "text-1" } },
    { "at": 4, "step": { "kind": "tool.call", "who": { "team": "team-1", "actor": "lead" }, "tool": "ensure_worker", "args": { "name": "w1", "scope": "text-1" } } }
  ]
}
