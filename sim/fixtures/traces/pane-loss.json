{
  "version": 1,
  "id": "synthetic-pane-loss",
  "source": "synthetic",
  "assumptions": ["A-first-worker-pane-is-pane-1"],
  "setup": { "ptbVersion": "v3.1", "teams": [] },
  "steps": [
    { "at": 0, "step": { "kind": "pi.start", "who": { "team": "team-1", "actor": "lead" }, "session": "session-1", "reason": "startup" } },
    { "at": 0, "step": { "kind": "tool.call", "who": { "team": "team-1", "actor": "lead" }, "tool": "team_create", "args": { "name": "team-1" } } },
    { "at": 0, "step": { "kind": "tool.call", "who": { "team": "team-1", "actor": "lead" }, "tool": "ensure_worker", "args": { "name": "w1", "scope": "text-1" } } },
    { "at": 0, "step": { "kind": "herdr.agentState", "pane": "pane-1", "state": "working" } },
    { "at": 0, "step": { "kind": "human.closePane", "pane": "pane-1" } },
    { "at": 0, "step": { "kind": "os.kill", "who": { "team": "team-1", "actor": "w1" }, "signal": "SIGHUP" } },
    { "at": 0, "step": { "kind": "herdr.restart" } },
    { "at": 0, "step": { "kind": "tool.call", "who": { "team": "team-1", "actor": "lead" }, "tool": "ensure_worker", "args": { "name": "w1", "scope": "text-1" } } }
  ]
}
