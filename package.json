{
  "name": "@hypercarrier/pi-team-bright",
  "version": "0.15.0-rc.1",
  "description": "Task-first Pi teams, visible in terminal panes.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deephbz/pi-team-bright.git"
  },
  "homepage": "https://github.com/deephbz/pi-team-bright#readme",
  "bugs": {
    "url": "https://github.com/deephbz/pi-team-bright/issues"
  },
  "author": "Mark Burggraf",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "ai-agent",
    "multi-agent",
    "agent-teams",
    "agent-coordination",
    "autonomous-agents",
    "task-management",
    "team-collaboration",
    "agent-orchestration",
    "coding-assistant",
    "terminal",
    "tmux"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:observation": "rm -rf dist && tsc -p tsconfig.observation.json",
    "verify:observation-package": "npm run build:observation && node scripts/verify-observation-package.cjs",
    "verify:package": "npm run verify:observation-package",
    "prepare": "npm run build:observation",
    "test": "npm run typecheck && vitest run",
    "qa:tool-results:history": "ts-node --transpile-only scripts/tool-result-qa/mine-history.ts",
    "qa:tool-results": "vitest run scripts/tool-result-qa/suite.test.ts",
    "qa:tool-results:iterate": "npm run qa:tool-results:history && npm run qa:tool-results",
    "migrate:tasks": "ts-node --transpile-only src/cli/migrate-tasks.ts"
  },
  "main": "extensions/index.ts",
  "exports": {
    ".": "./extensions/index.ts",
    "./observation": {
      "types": "./dist/public/observation.d.ts",
      "default": "./dist/public/observation.js"
    }
  },
  "files": [
    "extensions",
    "skills",
    "src",
    "!src/**/*.test.ts",
    "!src/**/fixtures",
    "tsconfig.json",
    "package.json",
    "LICENSE",
    "README.md",
    "iTerm2.png",
    "pi-team-in-action.png",
    "tmux.png",
    "zellij.png",
    "docs/current/README.md",
    "docs/reference.md",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^0.80.10",
    "@earendil-works/pi-coding-agent": "^0.80.10",
    "@earendil-works/pi-tui": "^0.80.10",
    "typebox": "^1.1.38"
  },
  "pi": {
    "image": "https://raw.githubusercontent.com/deephbz/pi-team-bright/main/pi-team-in-action.png",
    "extensions": [
      "extensions/index.ts"
    ],
    "skills": [
      "skills"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-tui": "0.80.10",
    "@types/node": "^25.3.0",
    "vitest": "^4.1.10"
  }
}
